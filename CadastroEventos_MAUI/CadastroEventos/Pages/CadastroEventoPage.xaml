<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Pages.CadastroEventoPage"
             Title="Cadastro de Evento">
    <ScrollView>
        <VerticalStackLayout Padding="22,20,22,30" Spacing="18">
            <VerticalStackLayout Spacing="5">
                <Label Text="NOVO CADASTRO"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Teal}"
                       CharacterSpacing="1.5" />
                <Label Text="Cadastro de Eventos"
                       FontSize="27"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Navy}" />
                <Label Text="Preencha os dados para organizar seu evento e calcular os custos."
                       FontSize="14"
                       TextColor="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Line}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">
                <VerticalStackLayout Spacing="13">
                    <Label Text="INFORMAÇÕES DO EVENTO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource NavyLight}"
                           CharacterSpacing="1" />

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Nome do evento" FontAttributes="Bold" FontSize="13" />
                        <Entry Text="{Binding NomeEvento, Mode=TwoWay}"
                               Placeholder="Ex.: Feira de Tecnologia 2026"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Data de início" FontAttributes="Bold" FontSize="13" />
                            <DatePicker Date="{Binding DataInicio, Mode=TwoWay}"
                                        Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Data de término" FontAttributes="Bold" FontSize="13" />
                            <DatePicker Date="{Binding DataTermino, Mode=TwoWay}"
                                        Format="dd/MM/yyyy" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Número de participantes" FontAttributes="Bold" FontSize="13" />
                        <Entry Text="{Binding NumeroParticipantesTexto, Mode=TwoWay}"
                               Placeholder="Ex.: 150"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Local do evento" FontAttributes="Bold" FontSize="13" />
                        <Entry Text="{Binding LocalEvento, Mode=TwoWay}"
                               Placeholder="Ex.: Centro de Convenções" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Custo por participante (R$)" FontAttributes="Bold" FontSize="13" />
                        <Entry Text="{Binding CustoPorParticipanteTexto, Mode=TwoWay}"
                               Placeholder="Ex.: 85,00"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource TealSoft}"
                    Stroke="#C9E5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="CÁLCULO AUTOMÁTICO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Teal}"
                           CharacterSpacing="1" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="9">
                        <Label Text="Duração do evento" FontSize="14" TextColor="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding DuracaoFormatada}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                        <Label Grid.Row="1" Text="Custo total estimado" FontSize="14" TextColor="{StaticResource Muted}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CustoTotalFormatado}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Teal}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Cadastrar evento"
                    Clicked="OnCadastrarClicked"
                    BackgroundColor="{StaticResource Navy}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="54"
                    CornerRadius="15" />

            <Label Text="Os valores são atualizados automaticamente conforme você preenche o formulário."
                   FontSize="12"
                   TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
